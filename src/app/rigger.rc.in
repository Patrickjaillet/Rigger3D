#include <winver.h>

IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/assets/app/rigger.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Patrick JAILLET"
      VALUE "FileDescription", "Rigger3D - 3D character animation"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "rigger"
      VALUE "OriginalFilename", "rigger.exe"
      VALUE "ProductName", "Rigger3D"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "Copyright (C) 2026 Patrick JAILLET - GPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
